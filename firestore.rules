rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check admin status
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "apex7tech@gmail.com" ||
        request.auth.token.role == "admin"
      );
    }

    // Public / Shared Chart access for online access from internet
    match /saved_charts/{chartId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Gemstones public catalog & management
    match /gemstones/{gemstoneId} {
      allow read: if true;
      allow write: if true;
    }

    // Clients Directory
    match /clients/{clientId} {
      allow read, write: if true;
    }

    // Appointments & Bookings
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Invoices & Purchases
    match /sales_invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /purchase_orders/{orderId} {
      allow read, write: if true;
    }

    // Users & Roles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read, write: if true;
    }

    // Store Settings
    match /store_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Fallback rule for all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
